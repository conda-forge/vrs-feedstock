+if(TARGET RapidJSON::rapidjson AND NOT TARGET rapidjson::rapidjson)
+  add_library(rapidjson::rapidjson INTERFACE IMPORTED)
+  set_target_properties(rapidjson::rapidjson PROPERTIES
+    INTERFACE_LINK_LIBRARIES RapidJSON::rapidjson
+  )
+elseif(TARGET rapidjson AND NOT TARGET rapidjson::rapidjson)
+  add_library(rapidjson::rapidjson INTERFACE IMPORTED)
+  set_target_properties(rapidjson::rapidjson PROPERTIES
+    INTERFACE_LINK_LIBRARIES rapidjson
+  )
+elseif(NOT TARGET rapidjson::rapidjson)
+  find_path(RAPIDJSON_INCLUDE_DIR NAMES rapidjson/rapidjson.h)
